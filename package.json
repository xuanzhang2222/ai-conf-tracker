{
  "name": "ai-conf-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/build-data.ts",
    "dev": "vite",
    "generate": "tsx scripts/build-data.ts && tsx scripts/build-ical.ts",
    "validate": "tsx scripts/validate-data.ts",
    "check-sources": "tsx scripts/check-sources.ts",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.11.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cheerio": "^1.2.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
